# Copy to .env and adjust locally. Compose reads .env from the repo
# root automatically, and so does the Go test harness.
#
# The container-side port is always 5432. POSTGRES_PORT sets only the
# host mapping, so a Postgres already running on this machine does not
# collide with the test database. Change it here and both compose and
# `go test` follow -- the harness builds its connection string from
# these variables rather than keeping a second copy of them.
#
# Setting DATABASE_URL in the environment overrides all of them.

POSTGRES_DB=cel
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_USER=cel

PREFIX=cel4postgres
